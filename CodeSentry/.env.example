# CodeSentry Environment Variables

# AI Provider Selection
# Options: 'openrouter' (default), 'anthropic'
AI_PROVIDER=openrouter

# OpenRouter API Key (optional)
# Enables AI-powered analysis using free models like Nemotron 3 Super
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Override the default OpenRouter model
# Options:
#   - 'auto' (default): Selects model based on codebase complexity
#     - Simple/small projects: nvidia/nemotron-3-super-120b-a12b:free
#     - Complex/large projects: nvidia/nemotron-3-ultra-550b-a55b:free
#   - Specific model ID: nvidia/nemotron-3-super-120b-a12b:free, nvidia/nemotron-3-ultra-550b-a55b:free,
#     z-ai/glm-5.2:free, minimax/minimax-m3:free, google/gemma-4-31b-it:free
OPENROUTER_MODEL=auto

# Optional: AI analysis timeout in milliseconds
# OPENROUTER_TIMEOUT=30000
